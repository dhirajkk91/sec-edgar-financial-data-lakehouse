# Copy to /etc/sec-edgar/env on the VM (install.sh does this) and fill in.
# The file is read by `docker run --env-file`, so no quotes around values.

# The SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT=SEC EDGAR Lakehouse yourname@example.com

# From `terraform output` in infra/aws.
SEC_EDGAR_LAKE=s3://sec-edgar-lake-yourname/sec-edgar
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DuckDB's memory cap for the Gold build; keep it below the container's --memory.
SEC_EDGAR_DUCKDB_MEMORY_LIMIT=4GB

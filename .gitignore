.DS_Store

# Local lakehouse outputs
/data/

# Python environment and generated files
.venv/
__pycache__/
*.py[cod]

# Development tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Package build output
dist/

# Generated dbt outputs
/transform/target/
/transform/logs/
/transform/dbt_packages/
/transform/.user.yml

# Terraform state holds the generated access keys; never commit it
infra/aws/.terraform/
infra/aws/*.tfstate
infra/aws/*.tfstate.*
infra/aws/terraform.tfvars
